<DATE>
<TIME>
$PROB TTE, WEIBULL HAZARD, EXPOSURE (CAVG) EFFECT   P:tte101  F:H~CAVG
$INPUT ID TIME DV MDV EVID DOSE CAVG
$DATA ../../data/tte-sim.csv IGNORE=@
$SUBR ADVAN13 TOL=9
$MODEL COMP=(CUMHAZ)

$PK
  LAM  = THETA(1) * EXP(ETA(1))
  GAM  = THETA(2)
  BETA = THETA(3)
  RH   = EXP(-BETA * CAVG)                ; hazard ratio per mg/L of average concentration

$DES
  DADT(1) = LAM * GAM * (T + 1E-9)**(GAM - 1) * RH

$ERROR
  CHZ = A(1)
  SUR = EXP(-CHZ)
  HAZ = LAM * GAM * (TIME + 1E-9)**(GAM - 1) * RH
  IF (DV.EQ.0) Y = SUR
  IF (DV.EQ.1) Y = HAZ * SUR

$THETA
  (0, 0.1)     ; LAM
  (0, 1)       ; GAM
  (1)          ; BETA per mg/L

$OMEGA 0 FIX

$EST MAX=9999 PRINT=5 METHOD=COND LAPLACE LIKELIHOOD NSIG=3 SIGL=9 NOABORT
$COV UNCOND PRINT=E
$TAB ID TIME DV MDV EVID DOSE CAVG CHZ SUR HAZ
     ONEHEADER NOPRINT FILE=sdtab
$TAB ID LAM RH
     ONEHEADER NOPRINT NOAPPEND FILE=patab
$TAB ID CAVG
     ONEHEADER NOPRINT NOAPPEND FILE=cotab
$TAB ID DOSE
     ONEHEADER NOPRINT NOAPPEND FILE=catab
  
NM-TRAN MESSAGES 
  
 WARNINGS AND ERRORS (IF ANY) FOR PROBLEM    1
             
 (WARNING  2) NM-TRAN INFERS THAT THE DATA ARE POPULATION.
             
 (WARNING  3) THERE MAY BE AN ERROR IN THE ABBREVIATED CODE. THE FOLLOWING
 ONE OR MORE RANDOM VARIABLES ARE DEFINED WITH "IF" STATEMENTS THAT DO NOT
 PROVIDE DEFINITIONS FOR BOTH THE "THEN" AND "ELSE" CASES. IF ALL
 CONDITIONS FAIL, THE VALUES OF THESE VARIABLES WILL BE ZERO.
  
   Y

  
